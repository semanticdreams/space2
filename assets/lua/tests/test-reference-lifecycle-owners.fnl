(local H (require :tests/test-reference-lifecycle-helpers))
(local fs (require :fs))
(local json (require :json))
(local J (require :json-utils))
(local sysinfo (require :sysinfo))
(local tests [])

(fn add [suffix f]
  (fn with-stores [root] (f (H.stores root)))
  (fn run [] (H.with-root with-stores))
  (table.insert tests {:name (.. "reference lifecycle owners " suffix) :fn run}))

(fn same [a b] (assert (= (J.stable-json a) (J.stable-json b)) "values differ"))
(fn fails [f] (local (ok _) (pcall f)) (assert (not ok) "required operation must fail"))
(fn utils [] (require :reference-lifecycle/record-utils))
(fn migration [s] ((. (require :reference-lifecycle/migration) :prepare) (H.domain-owners s) s))
(fn operation [kind source target retiring]
  {:kind kind :source-key source :target-key target :retiring retiring
   :updated-identity-keys [] :replacement false :timestamp 1700000000
   :reference-plan {:rewrites [] :identities []}})

;; chmod is restricted to the owned temporary fixture and always restored before
;; propagating an assertion. Portable directory collisions are tested separately.
(fn with-denied [path f]
  (local status (fs.stat path))
  (local command (string.format "chmod 000 %q" path))
  (local (ok _ _) (os.execute command))
  (assert ok "fixture chmod failed")
  (local (passed result) (pcall f))
  (local digits [])
  (for [offset 0 2]
    (var digit 0)
    (each [index bit (ipairs [4 2 1])]
      (when (not (= (string.sub status.permissions (+ (* offset 3) index) (+ (* offset 3) index)) "-"))
        (set digit (+ digit bit))))
    (table.insert digits (tostring digit)))
  (local mode (table.concat digits))
  (local (restored _ _) (os.execute (string.format "chmod %s %q" mode path)))
  (assert restored "fixture permission restoration failed")
  (if passed result (error result)))

(add "strict native listing" (fn strict-listing [s]
  (when (not (= (. (sysinfo.platform) :os) "windows"))
    (local path (fs.join-path s.base-dir "denied"))
    (fs.create-dirs path)
    (with-denied path (fn check-denied []
      (assert (= (length (fs.list-dir path false)) 0) "legacy browsing stays compatible")
      (fails (fn strict-read [] (fs.list-dir path false true)))))
    (local owner (. (H.domain-owners s) 1))
    (with-denied s.code-store.entities-dir (fn check-owner []
      (H.assert-error s.code-store.entities-dir (fn denied-inventory [] (owner:inventory))))))))

(add "native read completion" (fn read-completion [s]
  (fails (fn read-directory [] (fs.read-file s.base-dir)))))

(fn failure-case [s scheme action]
  (local store (. s (.. scheme "-store")))
  (local ext (if (= scheme "string") ".md" ".json"))
  (local path (fs.join-path store.entities-dir (.. "held" ext)))
  (local signal (. store (.. scheme "-entity-" (if (= action "create") "created" (= action "update") "updated" "deleted"))))
  (var emissions 0)
  (signal:connect (fn count-signal [_] (set emissions (+ emissions 1))))
  (if (= action "create")
      (do
        (fs.create-dirs (if (= scheme "code") (.. path ".tmp") path))
        (fails (fn create-collision [] (store:create-entity {:id "held" :value "old" :source "old"})))
        (fs.remove-all (if (= scheme "code") (.. path ".tmp") path))
        (assert (= (store:get-entity "held") nil) "failed create must not populate cache"))
      (do
        (local held (store:create-entity {:id "held" :value "old" :source "old"}))
        (local before (J.stable-json held))
        (set emissions 0)
        (if (= action "update")
            (do
              (fs.remove path)
              (fs.create-dirs (if (= scheme "code") (.. path ".tmp") path))
              (fails (fn update-collision [] (store:update-entity "held" {:value "poison" :source "poison"}))))
            (do
              (fs.remove path)
              (fs.create-dirs path)
              (fs.write-file (fs.join-path path "occupied") "x")
              (fails (fn remove-collision [] (store:retire-entity! "held")))))
        (assert (= (store:get-entity "held") held))
        (assert (= before (J.stable-json held)) "failed mutation poisoned held cache")))
  (signal:clear)
  (assert (= emissions 0) "failed persistence emitted signal"))

(add "string failed create" (fn [s] (failure-case s "string" "create")))
(add "string failed update" (fn [s] (failure-case s "string" "update")))
(add "string failed remove" (fn [s] (failure-case s "string" "remove")))
(add "code failed create" (fn [s] (failure-case s "code" "create")))
(add "code failed update" (fn [s] (failure-case s "code" "update")))
(add "code failed remove" (fn [s] (failure-case s "code" "remove")))

(add "cold string exact source" (fn cold-string [s]
  (local source " \t\n(+ 1 2)\n\n  ")
  (s.string-store:create-entity {:id "source" :value source :created-at 1 :updated-at 2})
  (local cold ((. (require :entities/string) :StringEntityStore) {:base-dir s.base-dir}))
  (local record (cold:get-entity "source"))
  (assert (= record.value source) "cold String must preserve exact source whitespace")
  (local snapshot (cold:snapshot-entity "source"))
  (assert (= snapshot.value.id "source"))
  (assert (= snapshot.bytes (cold:serialize-entity snapshot.value)))
  (local op (operation "morph" "string-entity:source" "code-entity:new" ["string-entity:source"]))
  (local owner (. (H.domain-owners s) 1))
  (local before (fs.read-file snapshot.path))
  (owner:prepare (owner:inventory) op)
  (assert (= before (fs.read-file snapshot.path)))))

(add "workflow held step failure" (fn held-step-failure [s]
  (local w s.workflow-store)
  (local definition (w:create-definition {:id "held" :steps [{:id "a" :name "old" :code-entity-id "code"}]}))
  (local held (. definition.steps 1))
  (local before (J.stable-json definition))
  (var signals 0)
  (w.definition-updated:connect (fn count-signal [_] (set signals (+ signals 1))))
  (fs.create-dirs (fs.join-path w.definitions-dir "held.json.tmp"))
  (fails (fn update-collision [] (w:update-step "held" "a" {:name "poison"})))
  (w.definition-updated:clear)
  (assert (= before (J.stable-json definition)) "failed workflow update poisoned definition")
  (assert (= held.name "old") "failed workflow update poisoned held step")
  (assert (= signals 0))))

(add "required reads" (fn required-reads [s]
  (local code-path (fs.join-path s.code-store.entities-dir "bad.json"))
  (fs.write-file code-path "{broken")
  (fails (fn read-malformed [] (s.code-store:get-entity "bad")))
  (fs.remove code-path)
  (fs.create-dirs code-path)
  (fails (fn read-collision [] (s.code-store:get-entity "bad")))
  (when (not (= (. (sysinfo.platform) :os) "windows"))
    (fs.remove-all code-path)
    (fs.write-file code-path "{}")
    (with-denied code-path (fn check-denied [] (fails (fn read-denied [] (s.code-store:get-entity "bad"))))))))

(add "snapshot decoder and ISO bytes" (fn snapshot-decoder [s]
  (local R (utils))
  (local absent (R.snapshot (fs.join-path s.base-dir "absent") "json" (fn reject-decode [_] (error "must not decode absence"))))
  (same [absent.bytes absent.value absent.check] [false false false])
  (fails (fn missing-decoder [] (R.snapshot absent.path "json" nil)))
  (local definition (s.workflow-store:create-definition {:id "iso" :created-at 1700000000 :updated-at 1700000001}))
  (local bytes (s.workflow-store:serialize-definition definition))
  (local persisted (json.loads bytes))
  (local snapshot (s.workflow-store:snapshot-definition "iso"))
  (assert (= (type snapshot.value.created-at) "number"))
  (assert (= snapshot.value.created-at definition.created-at))
  (assert (= (type persisted.created-at) "string"))
  (assert (string.find snapshot.bytes persisted.created-at 1 true))
  (assert (= snapshot.bytes (fs.read-file snapshot.path)))
  (assert (= snapshot.check (R.check-bytes snapshot.bytes "json")))
  (assert (= snapshot.check (R.check-bytes (s.workflow-store:serialize-definition snapshot.value) "json")))
  (local change (R.make-change "workflows" "workflow:iso" snapshot bytes "json" "incoming"))
  (local cold ((. (require :workflows/store) :WorkflowStore) {:base-dir s.base-dir}))
  (cold:persist-definition! "iso" change.after-bytes change.after-check)
  (assert (= change.after-check (. (cold:snapshot-definition "iso") :check)))))

(add "frozen persistence all stores" (fn frozen-persistence [s]
  (local R (utils))
  (each [_ name (ipairs ["string" "code" "list" "dict" "link" "identity"])]
    (local store (. s (.. name "-store")))
    (local held (store:create-entity {:id "frozen" :value " \nsource\n " :metadata {:tag 1}}))
    (local snapshot (store:snapshot-entity "frozen"))
    (local candidate (R.clone snapshot.value))
    (set candidate.created-at 123)
    (local bytes (store:serialize-entity candidate))
    (local format (if (= name "string") "string" "json"))
    (local collision (if (= name "string") snapshot.path (.. snapshot.path ".tmp")))
    (when (= name "string") (fs.remove snapshot.path))
    (fs.create-dirs collision)
    (fails (fn reject-write [] (store:persist-entity! "frozen" bytes (R.check-bytes bytes format))))
    (assert (= held.created-at snapshot.value.created-at) "prepared failure must not publish")
    (fs.remove-all collision)
    (when (= name "string") (fs.write-file snapshot.path snapshot.bytes))
    (local published (store:persist-entity! "frozen" bytes (R.check-bytes bytes format)))
    (assert (= held published) "prepared publication must preserve held record identity")
    (assert (= held.created-at 123))
    (assert (= (. (store:snapshot-entity "frozen") :check) (R.check-bytes bytes format))))
  (local held (s.notebook-store:create-notebook {:id "frozen"}))
  (local bytes (s.notebook-store:serialize-notebook held))
  (assert (= held (s.notebook-store:persist-notebook! "frozen" bytes (R.check-bytes bytes "json"))))))

(add "prepared failure and checks" (fn prepared-failure [s]
  (local R (utils))
  (local held (s.code-store:create-entity {:id "held" :source "old"}))
  (local candidate (R.clone held))
  (set candidate.source "new")
  (local bytes (s.code-store:serialize-entity candidate))
  (local before (H.snapshot-tree s.base-dir))
  (fails (fn wrong-check [] (s.code-store:persist-entity! "held" bytes "wrong")))
  (same before (H.snapshot-tree s.base-dir))
  (fs.create-dirs (fs.join-path s.code-store.entities-dir "held.json.tmp"))
  (fails (fn failed-write [] (s.code-store:persist-entity! "held" bytes (R.check-bytes bytes "json"))))
  (assert (= held.source "old"))
  (fs.remove-all (fs.join-path s.code-store.entities-dir "held.json.tmp"))
  (s.code-store.code-entity-updated:connect (fn reject-publication [_] (error "publication failure")))
  (H.assert-error "publication failure" (fn failed-publication [] (s.code-store:persist-entity! "held" bytes (R.check-bytes bytes "json"))))
  (s.code-store.code-entity-updated:clear)))

(fn legacy [s]
  (s.string-store:create-entity {:id "a" :value "A"})
  (J.write-json! (fs.join-path s.list-store.entities-dir "legacy.json")
                {:id "legacy" :name "legacy" :items ["string-entity:a" "external:z" "string-entity:a"] :created-at 1 :updated-at 2}))

(add "inventory and canonical composition" (fn inventory-composition [s]
  (legacy s)
  (s.code-store:create-entity {:id "c"})
  (s.code-store:create-entity {:id ".hidden"})
  (s.dict-store:create-entity {:id "d" :items {:one "string-entity:a"}})
  (s.link-store:create-entity {:id "e" :source-key "string-entity:a" :target-key "dict-entity:d"})
  (s.notebook-store:create-notebook {:id "n" :items ["string-entity:a"]})
  (local before (H.snapshot-tree s.base-dir))
  (local owners (H.domain-owners s))
  (local owner (. owners 1))
  (local inventory (owner:inventory))
  (assert (. inventory.records "string-entity:a"))
  (assert (. inventory.records "list-entity:legacy"))
  (each [_ key (ipairs ["code-entity:c" "code-entity:.hidden" "dict-entity:d" "link-entity:e" "notebook:n"])] (assert (. inventory.records key)))
  (assert (= (length inventory.sites) 7))
  (same before (H.snapshot-tree s.base-dir))
  (local wrong (H.stores (fs.join-path s.base-dir "other")))
  (set wrong.base-dir s.base-dir)
  (fails (fn wrong-root [] (H.domain-owners wrong)))
  (local broken (collect [key value (pairs s)] key value))
  (set broken.code-store (collect [key value (pairs s.code-store)] key value))
  (set broken.code-store.retire-entity! nil)
  (fails (fn missing-retirement [] (H.domain-owners broken)))))

(add "migration read only and idempotent" (fn migration-idempotent [s]
  (legacy s)
  (local before (H.snapshot-tree s.base-dir))
  (local first (migration s))
  (local held-caches (J.stable-json [s.string-store.cache s.code-store.cache s.list-store.cache s.dict-store.cache
                                    s.link-store.cache s.identity-store.cache s.notebook-store.cache s.workflow-store._definitions]))
  (fn forbidden [_self _key] (error "preparation must not use cache-producing or write-producing identity APIs"))
  (fn prepare-again [] (migration s))
  (local second (H.with-fields s.identity-store {:ensure-key forbidden :get-entity forbidden :list-entities forbidden} prepare-again))
  (assert (= held-caches (J.stable-json [s.string-store.cache s.code-store.cache s.list-store.cache s.dict-store.cache
                                       s.link-store.cache s.identity-store.cache s.notebook-store.cache s.workflow-store._definitions])))
  (same before (H.snapshot-tree s.base-dir))
  (assert (= (length first.runtime-state) 0))
  (assert (= (length first.operation.reference-plan.identities) 2))
  (assert (= (length second.operation.reference-plan.identities) 2))
  (assert (not (= (. (. first.operation.reference-plan.identities 1) :id) (. (. second.operation.reference-plan.identities 1) :id))))
  (H.apply-preparation! (H.domain-owners s) first)
  (local again (migration s))
  (assert (= (length again.changes) 0))
  (local items (. (s.list-store:get-entity "legacy") :items))
  (assert (= (length items) 2))
  (H.assert-reference s.identity-store (. items 1) "string-entity:a")
  (H.assert-reference s.identity-store (. items 2) "external:z")
  (fs.remove-all s.code-store.entities-dir)
  (assert (= (length (. (migration s) :changes)) 0) "missing owning roots are valid empty inventories")))

(add "migration aliases dangling and external" (fn migration-aliases [s]
  (legacy s)
  (s.identity-store:create-entity {:id "z" :target-key "string-entity:a"})
  (s.identity-store:create-entity {:id "a" :target-key "string-entity:a"})
  (s.identity-store:create-entity {:id "up" :target-key "identity:z"})
  (J.write-json! (fs.join-path s.list-store.entities-dir "legacy.json")
                {:id "legacy" :name "" :items ["identity:z" "string-entity:a" "identity:a" "identity:up" "string-entity:gone" "string-entity:gone" "external:z"] :created-at 1 :updated-at 2})
  (local prepared (migration s))
  (assert (= (length prepared.dangling) 2))
  (assert (= (. (. prepared.dangling 1) :target-key) "string-entity:gone"))
  (H.apply-preparation! (H.domain-owners s) prepared)
  (local items (. (s.list-store:get-entity "legacy") :items))
  (same [(. items 1) (. items 2) (. items 3) (. items 4) (. items 5)] ["identity:z" "identity:a" "identity:up" "string-entity:gone" "string-entity:gone"])
  (assert (= (. (s.identity-store:get-entity "up") :target-key) "identity:z"))
  (assert (= (length (. (migration s) :changes)) 0))))

(add "migration rejects invalid inputs" (fn migration-invalid [s]
  (local Migration (require :reference-lifecycle/migration))
  (s.identity-store:create-entity {:id "a" :target-key "identity:b"})
  (s.identity-store:create-entity {:id "b" :target-key "identity:a"})
  (local before (H.snapshot-tree s.base-dir))
  (H.assert-error "cycle" (fn cycle [] (migration s)))
  (same before (H.snapshot-tree s.base-dir))
  (s.identity-store:retire-entity! "a")
  (s.identity-store:retire-entity! "b")
  (fs.write-file (fs.join-path s.dict-store.entities-dir "bad.json") "{")
  (H.assert-error "bad.json" (fn malformed [] (migration s)))
  (fs.remove (fs.join-path s.dict-store.entities-dir "bad.json"))
  (J.write-json! (fs.join-path s.list-store.entities-dir "bad.json") {:id "bad" :items {:hidden "string-entity:a"} :created-at 1 :updated-at 1})
  (H.assert-error "bad.json" (fn invalid-array [] (Migration.prepare (H.domain-owners s) s)))))

(add "grouped workflow removal and history" (fn grouped-workflow [s]
  (local w s.workflow-store)
  (local definition (w:create-definition {:id "group" :steps [{:id "a" :code-entity-id "gone"} {:id "b" :code-entity-id "gone"} {:id "c" :code-entity-id "keep"}]
                                         :edges [{:id "ab" :source-step-id "a" :target-step-id "b"} {:id "bc" :source-step-id "b" :target-step-id "c"}]}))
  (local run (w:create-run "group" {} {}))
  (w:append-event run.id {:kind "kept"})
  (local history (fs.read-file (fs.join-path w.runs-dir (.. run.id ".json"))))
  (local before (J.stable-json definition))
  (local candidate (w:prepare-step-removal definition ["a" "b"] {:delete-dependent-edges? true}))
  (assert (= before (J.stable-json definition)))
  (assert (= (length candidate.steps) 1))
  (assert (= (length candidate.edges) 0))
  (local owner (. (H.domain-owners s) 3))
  (local op (operation "delete" "code-entity:gone" false ["code-entity:gone" "workflow-step:group:a" "workflow-step:group:b"]))
  (local inventory (owner:inventory))
  (assert (= (length (owner:expand inventory op)) 2))
  (local prepared (owner:prepare inventory op))
  (assert (= (length prepared.changes) 1))
  (local change (. prepared.changes 1))
  (assert (= (type (. (json.loads change.after-bytes) :updated-at)) "string"))
  (owner:apply! change)
  (assert (= (length definition.steps) 1))
  (assert (= history (fs.read-file (fs.join-path w.runs-dir (.. run.id ".json")))))
  (local cold ((. (require :workflows/store) :WorkflowStore) {:base-dir s.base-dir}))
  (assert (= change.after-check (. (cold:snapshot-definition "group") :check)))))

(add "delete and morph preparation" (fn delete-morph [s]
  (s.string-store:create-entity {:id "a" :value " \ntext\n "})
  (s.list-store:create-entity {:id "l" :items ["string-entity:a" "external:keep"]})
  (s.link-store:create-entity {:id "edge" :source-key "string-entity:a" :target-key "external:keep"})
  (local owners (H.domain-owners s))
  (local invalid (operation "unsupported" false false []))
  (local entities (. owners 1))
  (fails (fn unsupported-operation [] (entities:prepare (entities:inventory) invalid)))
  (local op (operation "delete" "string-entity:a" false ["string-entity:a"]))
  (local identity-owner (. owners 2))
  (local aliases (identity-owner:expand (identity-owner:inventory) op))
  (assert (= (length aliases) 1))
  (table.insert op.retiring (. aliases 1))
  (local owner (. owners 1))
  (assert (= (. (owner:expand (owner:inventory) op) 1) "link-entity:edge"))
  (local prepared (owner:prepare (owner:inventory) op))
  (assert (= (length prepared.runtime-state) 0))
  (assert (>= (length prepared.changes) 2))
  (local morph (operation "morph" "string-entity:a" "code-entity:replacement" ["string-entity:a"]))
  (local changes (identity-owner:prepare (identity-owner:inventory) morph))
  (assert (= (length changes.changes) 1))
  (assert (= (. (json.loads (. (. changes.changes 1) :after-bytes)) :target-key) "code-entity:replacement"))
  (set morph.reference-plan.identities [{:id "reserved" :target-key "code-entity:replacement" :created-at 1 :updated-at 1 :metadata {}}])
  (local reserved (identity-owner:prepare (identity-owner:inventory) morph))
  (assert (= (length reserved.changes) 2))
  (local creation (. reserved.changes 2))
  (assert (= creation.phase "replacement"))
  (assert (= (. (json.loads creation.after-bytes) :target-key) "code-entity:replacement"))
  (assert (= (s.identity-store:get-entity "reserved") nil))
  (set morph.replacement {:id "wrong" :source "source" :language "fnl" :name "" :kernel 0 :created-at 1 :updated-at 1})
  (fails (fn mismatched-replacement [] (owner:prepare (owner:inventory) morph)))))

(add "confined IDs and targets" (fn confined [s]
  (fails (fn create-escape [] (s.code-store:create-entity {:id "../escape"})))
  (local held (s.string-store:create-entity {:id "held" :value "safe"}))
  (fails (fn update-escape [] (s.string-store:update-entity "held" {:id "../escape"})))
  (assert (= held.id "held"))
  (local before (H.snapshot-tree s.base-dir))
  (fails (fn holder-escape [] (s.list-store:create-entity {:id "../escape" :items ["external:must-not-create"]})))
  (same before (H.snapshot-tree s.base-dir))
  (J.write-json! (fs.join-path s.list-store.entities-dir "wrong.json") {:id "different" :items [] :created-at 1 :updated-at 1})
  (fails (fn mismatched-id [] (migration s)))
  (fs.remove (fs.join-path s.list-store.entities-dir "wrong.json"))
  (J.write-json! (fs.join-path s.list-store.entities-dir "escape.json") {:id "escape" :items ["string-entity:../escape"] :created-at 1 :updated-at 1})
  (fails (fn escaped-reference [] (migration s)))))

(fn caches [s]
  [s.string-store.cache s.code-store.cache s.list-store.cache s.dict-store.cache
   s.link-store.cache s.identity-store.cache s.notebook-store.cache s.workflow-store._definitions])
(fn record-store [s kind] (. s (.. kind "-store")))
(fn record-snapshot [s kind id]
  (local store (record-store s kind))
  (if (= kind "notebook") (store:snapshot-notebook id)
      (= kind "workflow") (store:snapshot-definition id)
      (store:snapshot-entity id)))
(fn record-get [s kind id]
  (local store (record-store s kind))
  (if (= kind "notebook") (store:get-notebook id)
      (= kind "workflow") (store:get-definition id)
      (store:get-entity id)))
(fn raw-record-path [s kind]
  (local store (record-store s kind))
  (fs.join-path (if (= kind "notebook") store.notebooks-dir
                   (= kind "workflow") store.definitions-dir store.entities-dir) "invalid.json"))
(fn reject-record [s kind bytes diagnostic]
  (local path (raw-record-path s kind))
  (fs.write-file path bytes)
  (local tree (H.snapshot-tree s.base-dir))
  (local held (J.stable-json (caches s)))
  (fn snapshot [] (record-snapshot s kind "invalid"))
  (fn get [] (record-get s kind "invalid"))
  (fn prepare [] (migration s))
  (local message (H.assert-error path snapshot))
  (assert (string.find message diagnostic 1 true) message)
  (H.assert-error path get)
  (H.assert-error path prepare)
  (same tree (H.snapshot-tree s.base-dir))
  (assert (= held (J.stable-json (caches s))) "invalid persisted record published cache")
  (fs.remove path))

(add "dense array validation" (fn dense-array [_s]
  (local sparse ["external:a" "hole" "external:b" "external:c"])
  (tset sparse 2 nil)
  (assert (= (# sparse) 4) "fixture requires the native array border after the hole")
  (fails (fn reject-hole [] ((. (utils) :require-array) sparse)))))
(fn null-items [s kind items]
  (reject-record s kind (.. "{\"id\":\"invalid\",\"items\":" items ",\"created-at\":1,\"updated-at\":1}") "null"))
(add "list interior null fidelity" (fn [s] (null-items s "list" "[\"external:a\",null,\"external:b\",\"external:c\"]")))
(add "notebook interior null fidelity" (fn [s] (null-items s "notebook" "[\"external:a\",null,\"external:b\",\"external:c\"]")))
(add "list trailing null fidelity" (fn [s] (null-items s "list" "[\"external:a\",null]")))
(add "notebook trailing null fidelity" (fn [s] (null-items s "notebook" "[\"external:a\",null]")))
(add "null tokens and quoted strings" (fn quoted-null [s]
  (local path (raw-record-path s "identity"))
  (local bytes "{\"id\":\"invalid\",\"target-key\":\"external:null\",\"metadata\":{\"text\":\"null \\\"null\\\" \\\\ null\"},\"created-at\":1,\"updated-at\":1}")
  (fs.write-file path bytes)
  (local snapshot (s.identity-store:snapshot-entity "invalid"))
  (assert (= snapshot.value.metadata.text "null \"null\" \\ null"))
  (assert (= snapshot.bytes bytes))
  (fs.remove path)
  (reject-record s "identity" "{\"id\":\"invalid\",\"metadata\":{\"text\":null}}" "null")))

(add "trailing separator root equivalence" (fn trailing-root [s]
  (local trailing (fs.join-path s.base-dir ""))
  (local other (H.stores trailing))
  (local held (other.code-store:create-entity {:id "root" :source "safe"}))
  (local plain (s.code-store:snapshot-entity "root"))
  (local suffix (other.code-store:snapshot-entity "root"))
  (assert (= plain.path suffix.path))
  (assert (= suffix.value.source held.source))
  (local R (utils))
  (assert (= (R.record-path trailing other.code-store.entities-dir "root" ".json") plain.path))
  (fails (fn escape [] (R.record-path trailing other.code-store.entities-dir "../escape" ".json")))))
(add "filesystem root path formation" (fn root-formation [s]
  (local R (utils))
  (var root (fs.absolute s.base-dir))
  (while (not (= (fs.parent root) root)) (set root (fs.parent root)))
  ;; Pure path formation only: never stat/read/write the host filesystem root.
  (local directory (fs.join-path root "entities" "code"))
  (local expected (fs.absolute (fs.join-path directory "pure.json")))
  (local (path normalized-root) (R.record-location (fs.join-path root "") directory "pure" ".json"))
  (assert (= path expected))
  (assert (= normalized-root root))))

(fn invalid-field [s kind field]
  (local data {:id "invalid" :created-at 1 :updated-at 1})
  (tset data field false)
  (reject-record s kind (json.dumps data) field))
(add "persisted false reference fields" (fn false-references [s]
  (each [_ fixture (ipairs [["identity" "target-key"] ["identity" "metadata"]
                         ["list" "items"] ["notebook" "items"] ["dict" "items"]
                         ["link" "source-key"] ["link" "target-key"] ["link" "metadata"]])]
    (invalid-field s (. fixture 1) (. fixture 2)))))
(fn invalid-member [s kind field]
  (local data {:id "invalid" :created-at 1 :updated-at 1})
  (if (= kind "dict") (set data.items {:slot false})
      (set data.items [false]))
  (reject-record s kind (json.dumps data) field))
(fn invalid-workflow-step [s field]
  (local step {:id "a" :code-entity-id "code"})
  (tset step field false)
  (reject-record s "workflow" (json.dumps {:id "invalid" :created-at 1 :updated-at 1 :steps [step]}) field))
(add "persisted typed fields" (fn typed-fields [s]
  (each [_ kind (ipairs ["code" "list" "dict" "notebook" "identity" "link"])]
    (invalid-field s kind "created-at"))
  (each [_ kind (ipairs ["code" "list" "dict" "notebook"])] (invalid-field s kind "name"))
  (each [_ field (ipairs ["source" "language" "kernel"])] (invalid-field s "code" field))
  (each [_ kind (ipairs ["list" "dict" "notebook"])] (invalid-member s kind "reference"))
  (each [_ field (ipairs ["name" "description" "version" "status" "parameters" "steps" "edges"])]
    (invalid-field s "workflow" field))
  (each [_ field (ipairs ["name" "code-entity-id" "config" "input-schema" "output-schema" "retry" "timeout-ms"])]
    (invalid-workflow-step s field))))
(add "absent optional defaults" (fn optional-defaults [s]
  (each [_ kind (ipairs ["identity" "link" "list" "dict" "notebook" "code" "workflow"])]
    (local path (raw-record-path s kind))
    (fs.write-file path "{\"id\":\"invalid\",\"created-at\":1,\"updated-at\":1}")
    (local value (. (record-snapshot s kind "invalid") :value))
    (assert (= value.id "invalid"))
    (when value.items (assert (= (length value.items) 0)))
    (fs.remove path))))
(add "workflow false payload preservation" (fn false-payload [s]
  (local w s.workflow-store)
  (local definition (w:create-definition {:id "false-payload" :parameters {:flag false}
                                         :steps [{:id "a" :code-entity-id "code" :config {:flag false}}
                                                 {:id "b" :code-entity-id "code"}]
                                         :edges [{:id "e" :source-step-id "a" :target-step-id "b" :condition false}]}))
  (local snapshot (w:snapshot-definition definition.id))
  (assert (= snapshot.value.parameters.flag false))
  (assert (= (. snapshot.value.steps 1 :config :flag) false))
  (assert (= (. snapshot.value.edges 1 :condition) false))
  (local run (w:create-run definition.id {:flag false} {}))
  (w:append-event run.id {:kind "kept" :payload false})
  (local tree (H.snapshot-tree s.base-dir))
  (migration s)
  (same tree (H.snapshot-tree s.base-dir))
  (local bytes (fs.read-file (fs.join-path w.runs-dir (.. run.id ".json"))))
  (assert (= (. (json.loads bytes) :events 1 :payload) false))))

{:tests tests}
