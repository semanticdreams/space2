(local H (require :tests/test-reference-lifecycle-helpers))
(local fs (require :fs))
(local J (require :json-utils))
(local R (require :reference-lifecycle/record-utils))
(local tests [])
(fn add [name f]
  (fn with-stores [root] (f (H.stores root)))
  (fn run [] (H.with-root with-stores))
  (table.insert tests {:name (.. "reference lifecycle commands " name) :fn run}))
(fn same [a b] (assert (= (J.stable-json a) (J.stable-json b)) "values differ"))
(fn plan [s owners request] ((. (require :reference-lifecycle/plan) :prepare) owners s request))
(fn seed [s] (s.string-store:create-entity {:id "s" :value " \n(+ 1 2)\n "}))
(fn payload [] {:name "" :language "fnl" :source " \n(+ 1 2)\n " :kernel 0})

;; RED exercised the native StringEntityNode delete and existing Morphs action.
;; The identical persistence assertions now exercise the explicit coordinator.
(fn delete-source [s]
  (: (H.ready s) :delete! "string-entity:s"))
(fn morph-source [s]
  (: (H.ready s) :replace! "string-entity:s" (payload)))

(add "unopened incoming cleanup" (fn unopened [s]
  (seed s)
  (s.list-store:create-entity {:id "l" :items ["string-entity:s"]})
  (delete-source s)
  (local cold (H.stores s.base-dir))
  (assert (= (length (. (cold.list-store:get-entity "l") :items)) 0) "unopened list must lose incoming reference")
  (assert (= (cold.string-store:get-entity "s") nil))))
(add "morph unopened raw references" (fn morph-raw [s]
  (seed s)
  (H.raw-list s "raw" ["string-entity:s"])
  (local result (morph-source s))
  (local cold (H.stores s.base-dir))
  (local key (. (cold.list-store:get-entity "raw") :items 1))
  (H.assert-reference cold.identity-store key result.code-key)
  (assert (= result.code-entity.source (. (payload) :source)))))
(add "readiness and fixed owners" (fn readiness [s]
  (local Lifecycle (require :reference-lifecycle))
  (local service (H.lifecycle s))
  (H.assert-error "not ready" (fn unstarted [] (service:delete! "string-entity:s")))
  (each [_ id (ipairs ["entities" "identities" "workflows" "worlds" "runtime"])]
    (local incomplete (icollect [_ owner (ipairs (H.owners s))] (when (not (= owner.id id)) owner)))
    (H.assert-error "owner" (fn missing-owner [] (Lifecycle {:stores s :owners incomplete}))))
  (local broken (H.owners s))
  (set (. broken 5 :prepare) nil)
  (H.assert-error "capability" (fn missing-method [] (Lifecycle {:stores s :owners broken})))
  (local wrong (H.owners s))
  (set (. wrong 4 :base-dir) (fs.join-path s.base-dir "other"))
  (H.assert-error "root" (fn wrong-root [] (Lifecycle {:stores s :owners wrong})))
  (service:start!)
  (assert (= (. (service:delete! "string-entity:s") :status) "absent"))))
(add "exact canonical ownership" (fn ownership [s]
  (local service (H.lifecycle s))
  (assert (service:owns-store? "list-entity" s.list-store))
  (assert (service:owns-store? "identity" s.identity-store))
  (assert (not (service:owns-store? "external" s.list-store)))
  (local same-root (H.stores s.base-dir))
  (assert (not (service:owns-store? "list-entity" same-root.list-store)))
  (H.with-fields s.list-store {:identity-store same-root.identity-store}
    (fn wrong-dependency [] (assert (not (service:owns-store? "list-entity" s.list-store)))))
  (H.with-fields s.code-store {:base-dir (fs.join-path s.base-dir "other")}
    (fn wrong-root [] (assert (not (service:owns-store? "code-entity" s.code-store)))))
  (local before (H.snapshot-tree s.base-dir))
  (H.with-fields s.list-store {:identity-store same-root.identity-store}
    (fn reject-dependency [] (H.assert-error "identity" (fn start [] (service:start!)))))
  (same before (H.snapshot-tree s.base-dir))))
(add "sorted transitive relationship closure" (fn closure [s]
  (seed s)
  (s.string-store:create-entity {:id "keep"})
  (s.identity-store:create-entity {:id "direct" :target-key "string-entity:s"})
  (s.identity-store:create-entity {:id "up" :target-key "identity:direct"})
  (s.link-store:create-entity {:id "k1" :source-key "identity:up" :target-key "string-entity:keep"})
  (s.link-store:create-entity {:id "k2" :source-key "link-entity:k1" :target-key "link-entity:k3"})
  (s.link-store:create-entity {:id "k3" :source-key "link-entity:k2" :target-key "link-entity:k2"})
  (s.list-store:create-entity {:id "l" :items ["identity:up" "link-entity:k3" "string-entity:keep"]})
  (local service (H.ready s))
  (local result (service:delete! "string-entity:s"))
  (local sorted (R.clone result.retired-keys)) (table.sort sorted)
  (same sorted result.retired-keys)
  (each [_ id (ipairs ["k1" "k2" "k3"])] (assert (= (s.link-store:get-entity id) nil)))
  (assert (= (s.identity-store:get-entity "up") nil))
  (assert (s.string-store:get-entity "keep"))
  (assert (= (length (. (s.list-store:get-entity "l") :items)) 1))
  (assert (= result.source-record.value (. (payload) :source)))
  (assert (= (. (service:delete! "string-entity:s") :status) "absent"))))
(add "explicit identity does not delete target" (fn explicit-identity [s]
  (seed s)
  (s.identity-store:create-entity {:id "x" :target-key "string-entity:s"})
  (s.identity-store:create-entity {:id "up" :target-key "identity:x"})
  (s.identity-store:create-entity {:id "other" :target-key "string-entity:s"})
  (s.list-store:create-entity {:id "l" :items ["identity:x" "identity:up" "identity:other"]})
  (: (H.ready s) :delete! "identity:x")
  (assert (s.string-store:get-entity "s"))
  (assert (s.identity-store:get-entity "other"))
  (same (. (s.list-store:get-entity "l") :items) ["identity:other"])))
(add "container deletion never cascades outgoing" (fn containers [s]
  (seed s)
  (s.list-store:create-entity {:id "l" :items ["string-entity:s"]})
  (s.dict-store:create-entity {:id "d" :items {:slot "list-entity:l"}})
  (s.notebook-store:create-notebook {:id "n" :items ["dict-entity:d"]})
  (local service (H.ready s))
  (service:delete! "notebook:n")
  (assert (s.dict-store:get-entity "d"))
  (service:delete! "dict-entity:d")
  (assert (s.list-store:get-entity "l"))
  (service:delete! "list-entity:l")
  (assert (s.string-store:get-entity "s"))))
(add "workflow code cascade keeps history" (fn cascade [s]
  (s.code-store:create-entity {:id "c"})
  (local w s.workflow-store)
  (w:create-definition {:id "w" :steps [{:id "a" :code-entity-id "c"} {:id "b" :code-entity-id "c"} {:id "keep" :code-entity-id "other"}]
                        :edges [{:id "e" :source-step-id "a" :target-step-id "keep"}]})
  (local run (w:create-run "w" {} {}))
  (w:append-event run.id {:kind "history"})
  (local path (fs.join-path w.runs-dir (.. run.id ".json")))
  (local history (fs.read-file path))
  (s.list-store:create-entity {:id "l" :items ["workflow-step:w:a"]})
  (s.link-store:create-entity {:id "z" :source-key "code-entity:c" :target-key "external:keep"})
  (s.link-store.link-entity-deleted:connect (fn assert-source-last [_]
    (assert (. (s.code-store:snapshot-entity "c") :value) "code source must survive dependent retirement")))
  (: (H.ready s) :delete! "code-entity:c")
  (s.link-store.link-entity-deleted:clear)
  (same (icollect [_ step (ipairs (. (w:get-definition "w") :steps))] step.id) ["keep"])
  (assert (= (length (. (w:get-definition "w") :edges)) 0))
  (assert (= (length (. (s.list-store:get-entity "l") :items)) 0))
  (assert (= (fs.read-file path) history))))
(add "workflow step source change last" (fn step-last [s]
  (local definition (s.workflow-store:create-definition {:id "w" :steps [{:id "a" :name "actual source" :code-entity-id "c"}]}))
  (s.link-store:create-entity {:id "z" :source-key "workflow-step:w:a" :target-key "external:keep"})
  (local service (H.ready s))
  (s.workflow-store.definition-updated:connect (fn check-order [_]
    (assert (= (s.link-store:get-entity "z") nil) "dependent retirement must precede step source change")))
  (local result (service:delete! "workflow-step:w:a"))
  (s.workflow-store.definition-updated:clear)
  (assert (= result.source-record.id "a"))
  (assert (= result.source-record.name "actual source"))
  (assert (= (length definition.steps) 0))))
(add "unsupported and alias cycles preflight" (fn invalid [s]
  (seed s)
  (local service (H.ready s))
  (local before (H.snapshot-tree s.base-dir))
  (each [_ key (ipairs ["external:x" "file:/tmp/x" "workflow:w" "workflow-step:w" "workflow-step:w:a:extra"])]
    (H.assert-error "unsupported" (fn reject-key [] (service:delete! key))))
  (same before (H.snapshot-tree s.base-dir))
  (s.identity-store:create-entity {:id "a" :target-key "identity:b"})
  (s.identity-store:create-entity {:id "b" :target-key "identity:a"})
  (local cyclic (H.snapshot-tree s.base-dir))
  (H.assert-error "cycle" (fn reject-cycle [] (service:delete! "string-entity:s")))
  (same cyclic (H.snapshot-tree s.base-dir))))
(add "duplicate paths and captures rejected" (fn duplicates [s]
  (seed s)
  (local world (H.empty-owner "worlds" s.base-dir))
  (fn duplicate [_ _inv _op]
    (local snap (s.string-store:snapshot-entity "s"))
    {:changes [(R.make-change "worlds" "bad" snap false "string" "incoming")] :runtime-state []})
  (set world.prepare duplicate)
  (H.assert-error "duplicate durable path" (fn paths [] (plan s (H.owners s world) {:kind "delete" :source-key "string-entity:s"})))
  (local runtime (H.empty-owner "runtime" s.base-dir))
  (fn captures [_ _inv _op]
    (local capture {:owner "runtime" :world-id "w" :map-id false :before {} :after {}})
    {:changes [] :runtime-state [capture capture]})
  (set runtime.prepare captures)
  (H.assert-error "duplicate runtime capture" (fn namespaces [] (plan s (H.owners s nil runtime) {:kind "delete" :source-key "string-entity:s"})))
  (local empty (: (H.empty-owner "worlds" s.base-dir) :prepare {} {}))
  (same empty {:changes [] :runtime-state []})))
(add "frozen namespaced captures before apply" (fn frozen [s]
  (seed s)
  (local runtime (H.empty-owner "runtime" s.base-dir))
  (local capture {:owner "runtime" :world-id "w" :map-id "m" :before {:maps {:nodes ["string-entity:s"]}} :after {:maps {:nodes []}}})
  (set runtime.prepare (fn prepare [_ _inv op] {:changes [] :runtime-state (if (= op.kind "migrate") [] [capture])}))
  (local service (H.ready s nil runtime))
  (s.string-store.string-entity-deleted:connect (fn check-journal [_]
    (local intent (: ((require :reference-lifecycle/pending) s.base-dir) :read))
    (same intent.runtime-state [capture])
    (assert (= intent.version 1))))
  (service:delete! "string-entity:s")
  (s.string-store.string-entity-deleted:clear)))
(add "morph reservation read only and alias preservation" (fn reservations [s]
  (seed s)
  (s.identity-store:create-entity {:id "z" :target-key "string-entity:s"})
  (s.identity-store:create-entity {:id "a" :target-key "string-entity:s"})
  (s.identity-store:create-entity {:id "up" :target-key "identity:z"})
  (H.raw-list s "raw" ["string-entity:s" "identity:z" "identity:up"])
  (local before (H.snapshot-tree s.base-dir))
  (fn readonly []
    (plan s (H.owners s) {:kind "morph" :source-key "string-entity:s" :payload (payload)}))
  (fn guarded [] (H.no-writes readonly))
  (fn forbidden-ensure [_ _key] (error "preflight must not call ensure-key"))
  (local intent (H.with-fields s.identity-store {:ensure-key forbidden-ensure} guarded))
  (same before (H.snapshot-tree s.base-dir))
  (same intent.operation.reference-plan.rewrites [{:from-key "string-entity:s" :to-key "identity:a"}])
  (local service (H.ready s))
  (local result (service:replace! "string-entity:s" (payload)))
  (same result.updated-identity-keys ["identity:a" "identity:z"])
  (assert (= (. (s.identity-store:get-entity "up") :target-key) "identity:z"))
  (same (. (s.list-store:get-entity "raw") :items) ["identity:a" "identity:z" "identity:up"])))
(add "ordinary publication exactly once" (fn once [s]
  (seed s)
  (local list (s.list-store:create-entity {:id "l" :items ["string-entity:s"]}))
  (local service (H.ready s))
  (var updates 0) (var items 0) (var deletes 0)
  (s.list-store.list-entity-updated:connect (fn [record] (assert (= record list)) (set updates (+ updates 1))))
  (s.list-store.list-entity-items-changed:connect (fn [_] (set items (+ items 1))))
  (s.string-store.string-entity-deleted:connect (fn [_] (set deletes (+ deletes 1))))
  (service:delete! "string-entity:s")
  (s.list-store.list-entity-updated:clear)
  (s.list-store.list-entity-items-changed:clear)
  (s.string-store.string-entity-deleted:clear)
  (same [updates items deletes] [1 1 1])))
(add "invalid morph payload preflight" (fn invalid-payload [s]
  (seed s)
  (local service (H.ready s))
  (local before (H.snapshot-tree s.base-dir))
  (each [_ replacement (ipairs [{:name "" :language "python" :source "x" :kernel 0}
                                {:name "" :language "fnl" :source "wrong" :kernel 0}
                                {:name "" :language "fnl" :source " \n(+ 1 2)\n " :kernel false}])]
    (H.assert-error "morph" (fn invalid [] (service:replace! "string-entity:s" replacement))))
  (same before (H.snapshot-tree s.base-dir))))
(add "pending source and capture validation" (fn journal-validation [s]
  (seed s)
  (s.list-store:create-entity {:id "l" :items ["string-entity:s"]})
  (local service (H.ready s))
  (local Pending (require :reference-lifecycle/pending))
  (local pending (Pending s.base-dir))
  (local path (. (s.list-store:snapshot-entity "l") :path))
  (H.with-fs-failure "write-file" (.. path ".tmp") (fn fail-incoming []
    (H.assert-error "l.json" (fn delete [] (service:delete! "string-entity:s")))))
  (local original (pending:read))
  (local changed (R.clone original))
  (set changed.source-fingerprint.path path)
  (pending:write! changed)
  (H.assert-error "source" (fn wrong-source [] (service:delete! "string-entity:s")))
  (assert (. (s.string-store:snapshot-entity "s") :value))
  (local capture {:owner "runtime" :world-id "w" :map-id false :before {} :after {}})
  (set original.runtime-state [capture capture])
  (pending:write! original)
  (H.assert-error "duplicate runtime capture" (fn wrong-captures [] (service:delete! "string-entity:s")))
  (assert (. (s.string-store:snapshot-entity "s") :value))))
(fn delete-code [s]
  (: (H.ready s) :delete! "code-entity:c"))
(add "native code workflow dependencies" (fn native-code [s]
  (s.code-store:create-entity {:id "c"})
  (s.workflow-store:create-definition {:id "w" :steps [{:id "a" :code-entity-id "c"}]})
  (delete-code s)
  (local cold (H.stores s.base-dir))
  (assert (= (length (. (cold.workflow-store:get-definition "w") :steps)) 0) "native code delete must remove live workflow dependencies")))
(add "identity depth uses native boundary" (fn depth-boundary [s]
  (seed s)
  (local service (H.ready s))
  (for [index 1 32]
    (s.identity-store:create-entity {:id (.. "depth" index)
      :target-key (if (= index 32) "identity:missing" (.. "identity:depth" (+ index 1)))}))
  (s.identity-store:create-entity {:id "too-deep" :target-key "identity:depth1"})
  (local before (H.snapshot-tree s.base-dir))
  (H.assert-error "depth" (fn too-deep [] (service:delete! "string-entity:s")))
  (same before (H.snapshot-tree s.base-dir))
  (s.identity-store:retire-entity! "too-deep")
  (assert (= (s.identity-store:resolve-key "identity:depth1") "identity:missing"))
  (assert (= (. (service:delete! "string-entity:s") :status) "deleted"))))
(fn invalid-capture [s capture]
  (local runtime (H.empty-owner "runtime" s.base-dir))
  (set runtime.prepare (fn prepare [_ _inv op]
    {:changes [] :runtime-state (if (= op.kind "migrate") [] [capture])}))
  (local service (H.ready s nil runtime))
  (local before (H.snapshot-tree s.base-dir))
  (H.assert-error "runtime capture" (fn prepare []
    (plan s service.owners {:kind "delete" :source-key "string-entity:s"})))
  (same before (H.snapshot-tree s.base-dir))
  (H.assert-error "runtime capture" (fn delete [] (service:delete! "string-entity:s")))
  (same before (H.snapshot-tree s.base-dir))
  (assert (not (fs.exists (fs.join-path s.base-dir "reference-lifecycle" "pending.json")))))
(each [_ missing (ipairs ["before" "after" "both"])]
  (add (.. "capture " (if (= missing "both") "both missing" (.. "missing " missing)) " rejected")
    (fn missing-state [s]
      (seed s)
      (local capture {:owner "runtime" :world-id "w" :map-id false :before {} :after {}})
      (when (not (= missing "after")) (set capture.before nil))
      (when (not (= missing "before")) (set capture.after nil))
      (invalid-capture s capture))))
(add "capture asymmetric roles rejected" (fn asymmetric [s]
  (seed s)
  (each [_ role (ipairs ["board" "maps" "views" "metadata"])]
    (each [_ side (ipairs ["before" "after"])]
      (local capture {:owner "runtime" :world-id "w" :map-id false :before {} :after {}})
      (tset (. capture side) role {})
      (invalid-capture s capture)))))
(add "capture empty states allowed" (fn empty-states [s]
  (seed s)
  (local runtime (H.empty-owner "runtime" s.base-dir))
  (local capture {:owner "runtime" :world-id "w" :map-id false :before {} :after {}})
  (set runtime.prepare (fn prepare [_ _inv op]
    {:changes [] :runtime-state (if (= op.kind "migrate") [] [capture])}))
  (local service (H.ready s nil runtime))
  (local intent (plan s service.owners {:kind "delete" :source-key "string-entity:s"}))
  (same intent.runtime-state [capture])
  (assert (= (. (service:delete! "string-entity:s") :status) "deleted"))))
{:tests tests}
